# QueryMind AI — Frontend Environment Configuration Example
# By default, the global root .env (see /.env.example) is used for both backend and frontend.
# Create frontend/.env only if you need frontend-specific overrides.

# Local development backend:
VITE_API_BASE_URL=http://localhost:8000

# Production backend (set in Vercel Environment Variables or frontend/.env when building):
# VITE_API_BASE_URL=https://querymind-ai.onrender.com

# Vite dev/preview ports
VITE_PORT=5173
VITE_PREVIEW_PORT=4173
