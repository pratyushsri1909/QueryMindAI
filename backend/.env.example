# QueryMind AI — Backend Environment Configuration Example
# Copy this file to .env and configure for your local environment:
# cp .env.example .env

# Execution Mode: "mock" (default, Day 2 pipeline) or "database" (PostgreSQL execution)
QUERYMIND_MODE=mock

# PostgreSQL Database Connection URL (SQLAlchemy + psycopg 3 format)
# PRODUCTION SECURITY REQUIREMENT:
# In production, use the restricted least-privilege role created via backend/scripts/setup_restricted_role.sql
# Do NOT connect using the PostgreSQL superuser ('postgres') in production.
# DATABASE_URL=postgresql+psycopg://querymind_app:your_secure_password@localhost:5432/querymind_db
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/querymind_db

# Optional: Separate database URL for live PostgreSQL integration tests (used in CI)
# TEST_DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/querymind_test_db

# Query Safety: Statement execution timeout in milliseconds
DB_STATEMENT_TIMEOUT_MS=5000

# Comma-separated allowed frontend origins; set deployed origin(s) in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
