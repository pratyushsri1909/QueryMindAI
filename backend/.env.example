# QueryMind AI — Backend Environment Configuration Example
# By default, the global root .env (see /.env.example) is used for both backend and frontend.
# Create backend/.env only if you need backend-specific overrides.

# Execution Mode: "mock" (default prototype) or "database" (PostgreSQL / Supabase execution)
QUERYMIND_MODE=mock

# PostgreSQL Database Connection URL
# Accepts postgres://, postgresql://, or postgresql+psycopg:// (auto-normalized to psycopg 3).
#
# Local PostgreSQL example:
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/querymind_db
#
# Production Supabase (Render IPv4 -> Use Supabase Session/Transaction Pooler URL):
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Or with restricted read-only role (backend/scripts/setup_restricted_role.sql):
# DATABASE_URL=postgresql+psycopg://querymind_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Dedicated PostgreSQL Test Database URL (Mandatory for live integration tests in test_postgres_integration.py)
# SAFEGUARD: The target database name MUST contain 'test' (e.g. querymind_test_db) to prevent
# accidental destruction of application or production databases. Integration tests NEVER fall back to DATABASE_URL.
# Create locally: createdb -U postgres -h localhost -p 5432 querymind_test_db
# TEST_DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/querymind_test_db

# Query Safety & Connection Timeouts
DB_STATEMENT_TIMEOUT_MS=5000
DB_CONNECT_TIMEOUT=10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# DB_SSLMODE=require

# Comma-separated allowed frontend origins; include Vercel URL in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://querymind-ai.vercel.app
# CORS_ORIGIN_REGEX=
