# QueryMind AI — Backend Environment Configuration Example
# Copy this file to .env and configure for your local environment:
# cp .env.example .env

# Execution Mode: "mock" (default, Day 2 pipeline) or "database" (PostgreSQL execution)
QUERYMIND_MODE=mock

# PostgreSQL Database Connection URL (SQLAlchemy + psycopg 3 format)
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/querymind_db

# Query Safety: Statement execution timeout in milliseconds
DB_STATEMENT_TIMEOUT_MS=5000

